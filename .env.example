# Copy to .env (never commit .env). No real values here.
APP_ENV=development
APP_SECRET_KEY=replace_me_with_a_long_random_string
TOKEN_ENC_KEY=                       # Fernet key for OAuth token encryption: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# Reviewer login preloaded at startup (set a password; give it to graders in the private Classroom comment, not in the repo)
REVIEWER_EMAIL=reviewer@gigbid.demo
REVIEWER_PASSWORD=
REVIEWER_PERSONA=ai_ml_engineer

# Storage. Empty DATABASE_URL = SQLite files under data/processed/. Postgres checkpointer: postgresql://gigbid:gigbid@localhost:5432/gigbid
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CHECKPOINT_DB=
APP_DB=
MEMORY_DB=

# Marketplace
MARKETPLACE_MODE=gigsim              # gigsim | upwork_live (config.yaml marketplace.mode is authoritative)
GIGSIM_INPROCESS=1                   # 1 = GigSim-local mounted in the API process; 0 = use GIGSIM_BASE_URL
GIGSIM_BASE_URL=http://localhost:8081
MARKETPLACE_MCP_TOKENS=dev-token:local-user   # bearer tokens for the Marketplace MCP HTTP endpoint (token:user,...)
MCP_BACKEND=inprocess                # inprocess | http (separate MCP server processes)

# Models. offline = deterministic heuristics (default). open/paid = any OpenAI-compatible endpoint.
MODEL_PROFILE=offline
LLM_BASE_URL=                        # e.g. http://localhost:11434/v1 (Ollama) or https://api.groq.com/openai/v1
LLM_API_KEY=
PAID_LLM_BASE_URL=
PAID_LLM_API_KEY=

# Live Upwork (official MCP server, OAuth 2.1). Leave empty to stay in GigSim.
UPWORK_OAUTH_CLIENT_ID=
UPWORK_OAUTH_AUTHORIZE_URL=
UPWORK_OAUTH_TOKEN_URL=
UPWORK_OAUTH_REDIRECT=http://localhost:8000/connect/upwork/callback

# Tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Evaluation only
GIGBID_DEFENCES=on                   # off = measure injection attack success before defences
GIGBID_DISABLE=                      # ablation: risk_assessor,verifier,critic,compliance
GIGSIM_ERROR_RATE=0.02
GIGSIM_RATE_LIMIT=60
