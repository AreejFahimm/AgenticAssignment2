          "title": "Idempotency Key",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "screening_answers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screening Answers"
        }
      },
      "required": [
        "job_id",
        "cover_letter",
        "bid_amount",
        "idempotency_key"
      ],
