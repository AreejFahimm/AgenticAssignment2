          "title": "Idempotency Key",
          "type": "string"
        },
        "preview": {
          "additionalProperties": true,
          "title": "Preview",
          "type": "object"
        },
        "proposal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "dry_run",
        "status",
        "preview",
